{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "/usr/share/hwos/fastfetch/logo.txt",
    "color": {
      "1": "white",
      "2": "blue",
      "3": "red"
    },
    "padding": { "left": 1, "right": 1 }
  },
  "display": {
    "separator": " ${custom}",
    "color": "cyan"
  },
  "modules": [
    "title",
    "separator",
    { "type": "os", "key": "ОС", "keyColor": "white", "format": "{1}" },
    { "type": "host", "key": "Устройство", "keyColor": "blue", "format": "{1}" },
    { "type": "kernel", "key": "Ядро", "keyColor": "red", "format": "{1}" },
    { "type": "uptime", "key": "Работает", "keyColor": "white", "format": "{1}" },
    { "type": "packages", "key": "Пакеты", "keyColor": "blue", "format": "{1} ({2})" },
    { "type": "shell", "key": "Оболочка", "keyColor": "red", "format": "{1}" },
    { "type": "wm", "key": "Окружение", "keyColor": "white", "format": "{1}" },
    { "type": "terminal", "key": "Терминал", "keyColor": "blue", "format": "{1}" },
    { "type": "cpu", "key": "Процессор", "keyColor": "red", "format": "{1}" },
    { "type": "gpu", "key": "Видеокарта", "keyColor": "white", "format": "{1}" },
    { "type": "memory", "key": "Память", "keyColor": "blue", "format": "{1} / {2}" },
    { "type": "disk", "key": "Диск", "keyColor": "red", "format": "{1} / {2} ({3})" },
    { "type": "localip", "key": "IP", "keyColor": "white", "format": "{1} ({2})" },
    "separator",
    { "type": "custom", "format": "Сделано в Санкт-Петербурге ❤️" },
    { "type": "custom", "format": "hwos-help — список команд" }
  ]
}
