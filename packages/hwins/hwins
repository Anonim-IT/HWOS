#!/usr/bin/env bash
# hwins — Менеджер пакетов Hacker Web OS
# Версия: 1.0.0

set -euo pipefail

VERSION="1.0.0"
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
CYAN='\033[0;36m'; WHITE='\033[1;37m'; DIM='\033[2m'; NC='\033[0m'

LOGO="${CYAN}
██╗  ██╗██╗    ██╗ ██████╗ ███████╗
██║  ██║██║    ██║██╔═══██╗██╔════╝
███████║██║ █╗ ██║██║   ██║███████╗
██╔══██║██║███╗██║██║   ██║╚════██║
██║  ██║╚███╔███╔╝╚██████╔╝███████║
╚═╝  ╚═╝ ╚══╝╚══╝  ╚═════╝ ╚══════╝
${NC}"

usage() {
  echo -e "${LOGO}"
  echo -e "${WHITE}Менеджер пакетов HWOS v${VERSION}${NC}\n"
  echo -e "${YELLOW}Использование:${NC} hwins <команда> [параметры]\n"
  echo -e "${YELLOW}Команды:${NC}"
  echo -e "  ${GREEN}install${NC}    ${DIM}[-S]${NC}     Установить пакет(ы)"
  echo -e "  ${GREEN}remove${NC}     ${DIM}[-R]${NC}     Удалить пакет(ы)"
  echo -e "  ${GREEN}update${NC}     ${DIM}[-Sy]${NC}    Обновить базы данных"
  echo -e "  ${GREEN}upgrade${NC}    ${DIM}[-Su]${NC}    Обновить все пакеты"
  echo -e "  ${GREEN}sync${NC}       ${DIM}[-Syu]${NC}   Полная синхронизация и обновление"
  echo -e "  ${GREEN}search${NC}     ${DIM}[-Ss]${NC}    Поиск пакетов"
  echo -e "  ${GREEN}info${NC}       ${DIM}[-Si]${NC}    Информация о пакете"
  echo -e "  ${GREEN}list${NC}       ${DIM}[-Q]${NC}     Список установленных пакетов"
  echo -e "  ${GREEN}files${NC}      ${DIM}[-Fl]${NC}    Файлы, принадлежащие пакету"
  echo -e "  ${GREEN}clean${NC}      ${DIM}[-Sc]${NC}    Очистить кэш пакетов"
  echo -e "  ${GREEN}orphans${NC}    ${DIM}[-Qdt]${NC}   Сироты (ненужные пакеты)"
  echo -e "  ${GREEN}check${NC}               Проверить целостность пакетов"
  echo -e "  ${GREEN}help${NC}                Показать эту справку\n"
  echo -e "${DIM}Примеры:${NC}"
  echo -e "  hwins install firefox        ${DIM}Установить браузер${NC}"
  echo -e "  hwins search текстовый       ${DIM}Найти редактор${NC}"
  echo -e "  hwins update && hwins upgrade ${DIM}Обновить систему${NC}"
}

check_root() {
  [[ $EUID -eq 0 ]] && return
  echo -e "${YELLOW}[*] Нужны права root. Запускаю через sudo...${NC}"
  exec sudo "$0" "$@"
}

case "${1:-help}" in
  install|-S) check_root "$@"
    echo -e "${CYAN}[*] Установка...${NC}"
    pacman -S "${@:2}" ;;
  remove|-R) check_root "$@"
    echo -e "${YELLOW}[*] Удаление...${NC}"
    pacman -R "${@:2}" ;;
  update|-Sy) check_root "$@"
    echo -e "${CYAN}[*] Обновление баз данных...${NC}"
    pacman -Sy ;;
  upgrade|-Su) check_root "$@"
    echo -e "${CYAN}[*] Обновление пакетов...${NC}"
    pacman -Su "${@:2}" ;;
  sync|-Syu) check_root "$@"
    echo -e "${CYAN}[*] Полное обновление системы...${NC}"
    pacman -Syu ;;
  search|-Ss)
    echo -e "${CYAN}[*] Поиск...${NC}"
    pacman -Ss "${@:2}" ;;
  info|-Si) pacman -Si "${@:2}" ;;
  list|-Q)
    case "${2:-}" in
      foreign) pacman -Qm ;;
      explicit) pacman -Qe ;;
      *) pacman -Q "${@:2}" ;;
    esac ;;
  files|-Fl) pacman -Fl "${@:2}" ;;
  clean|-Sc) check_root "$@"
    echo -e "${YELLOW}[*] Очистка кэша...${NC}"
    pacman -Sc "${@:2}" ;;
  orphans|-Qdt)
    echo -e "${YELLOW}[*] Пакеты-сироты:${NC}"
    pacman -Qdt "${@:2}" ;;
  check)
    echo -e "${CYAN}[*] Проверка целостности...${NC}"
    pacman -Qk 2>/dev/null | grep -E 'ERROR|WARNING' ||
      echo -e "${GREEN}[+] Все пакеты в порядке${NC}" ;;
  help|--help|-h) usage ;;
  version|--version|-v)
    echo -e "${LOGO}"; echo -e "hwins v${VERSION} — менеджер пакетов HWOS" ;;
  *)
    echo -e "${RED}[!] Неизвестная команда: ${1}${NC}"
    echo -e "${YELLOW}[*] Используйте: hwins help${NC}"
    exit 1 ;;
esac
