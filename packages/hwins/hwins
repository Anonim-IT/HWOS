#!/usr/bin/env bash
# hwins - Hacker Web OS Package Manager
# HWOS custom wrapper around pacman
# Version: 1.0.0

set -euo pipefail

HWOS_VERSION="1.0.0"
HWOS_CODENAME="HWOS"
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
WHITE='\033[1;37m'
DIM='\033[2m'
NC='\033[0m'

ASCII_LOGO="${CYAN}
██╗  ██╗██╗    ██╗ ██████╗ ███████╗
██║  ██║██║    ██║██╔═══██╗██╔════╝
███████║██║ █╗ ██║██║   ██║███████╗
██╔══██║██║███╗██║██║   ██║╚════██║
██║  ██║╚███╔███╔╝╚██████╔╝███████║
╚═╝  ╚═╝ ╚══╝╚══╝  ╚═════╝ ╚══════╝
${NC}"

usage() {
    echo -e "${ASCII_LOGO}"
    echo -e "${WHITE}HWOS Package Manager v${HWOS_VERSION}${NC}\n"
    echo -e "${YELLOW}Usage:${NC} hwins <command> [options]\n"
    echo -e "${YELLOW}Commands:${NC}"
    echo -e "  ${GREEN}install${NC}    ${DIM}[-S]${NC}     Install package(s)"
    echo -e "  ${GREEN}remove${NC}     ${DIM}[-R]${NC}     Remove package(s)"
    echo -e "  ${GREEN}update${NC}     ${DIM}[-Sy]${NC}    Update package databases"
    echo -e "  ${GREEN}upgrade${NC}    ${DIM}[-Su]${NC}    Upgrade all packages"
    echo -e "  ${GREEN}sync${NC}       ${DIM}[-Syu]${NC}   Full system sync & upgrade"
    echo -e "  ${GREEN}search${NC}     ${DIM}[-Ss]${NC}    Search packages"
    echo -e "  ${GREEN}info${NC}       ${DIM}[-Si]${NC}    Show package info"
    echo -e "  ${GREEN}list${NC}       ${DIM}[-Q]${NC}     List installed packages"
    echo -e "  ${GREEN}files${NC}      ${DIM}[-Fl]${NC}    List files owned by package"
    echo -e "  ${GREEN}clean${NC}      ${DIM}[-Sc]${NC}    Clean package cache"
    echo -e "  ${GREEN}orphans${NC}    ${DIM}[-Qdt]${NC}   List orphan packages"
    echo -e "  ${GREEN}check${NC}               Verify package signatures & integrity"
    echo -e "  ${GREEN}help${NC}                Show this help\n"
    echo -e "${DIM}Examples:${NC}"
    echo -e "  hwins install fastfetch"
    echo -e "  hwins update && hwins upgrade"
    echo -e "  hwins search firefox"
    echo -e "  hwins list"
}

check_root() {
    if [[ $EUID -ne 0 ]]; then
        echo -e "${RED}[!] This operation requires root privileges${NC}"
        echo -e "${YELLOW}[*] Re-running with sudo...${NC}"
        exec sudo "$0" "$@"
    fi
}

check_integrity() {
    echo -e "${CYAN}[*] Checking package signatures and integrity${NC}"
    pacman -Qk 2>/dev/null | grep -E 'ERROR|WARNING' || echo -e "${GREEN}[+] All packages OK${NC}"
    echo -e "${CYAN}[*] Checking for modified packages${NC}"
    paccheck --md5sum --quiet 2>/dev/null || true
}

case "${1:-help}" in
    install|-S)
        check_root "$@"
        echo -e "${CYAN}[*] Installing packages...${NC}"
        pacman -S "${@:2}"
        ;;
    remove|-R)
        check_root "$@"
        echo -e "${YELLOW}[*] Removing packages...${NC}"
        pacman -R "${@:2}"
        ;;
    update|-Sy)
        check_root "$@"
        echo -e "${CYAN}[*] Syncing databases...${NC}"
        pacman -Sy
        ;;
    upgrade|-Su)
        check_root "$@"
        echo -e "${CYAN}[*] Upgrading system...${NC}"
        pacman -Su "${@:2}"
        ;;
    sync|-Syu)
        check_root "$@"
        echo -e "${CYAN}[*] Full system sync & upgrade...${NC}"
        pacman -Syu
        ;;
    search|-Ss)
        echo -e "${CYAN}[*] Searching...${NC}"
        pacman -Ss "${@:2}"
        ;;
    info|-Si)
        pacman -Si "${@:2}"
        ;;
    list|-Q)
        if [[ "${2:-}" == "foreign" ]]; then
            pacman -Qm
        elif [[ "${2:-}" == "explicit" ]]; then
            pacman -Qe
        else
            pacman -Q "${@:2}"
        fi
        ;;
    files|-Fl)
        pacman -Fl "${@:2}"
        ;;
    clean|-Sc)
        check_root "$@"
        echo -e "${YELLOW}[*] Cleaning package cache...${NC}"
        pacman -Sc "${@:2}"
        ;;
    orphans|-Qdt)
        echo -e "${YELLOW}[*] Orphan packages:${NC}"
        pacman -Qdt "${@:2}"
        ;;
    check)
        check_integrity
        ;;
    help|--help|-h)
        usage
        ;;
    version|--version|-v)
        echo -e "${ASCII_LOGO}"
        echo -e "HWOS Package Manager v${HWOS_VERSION}"
        echo -e "Based on: pacman ${WHITE}$(pacman -V | head -1 | awk '{print $2}')${NC}"
        ;;
    *)
        echo -e "${RED}[!] Unknown command: ${1}${NC}"
        echo -e "${YELLOW}[*] Use 'hwins help' for usage information${NC}"
        exit 1
        ;;
esac
