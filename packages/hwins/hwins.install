post_install() {
    echo "Добро пожаловать в HWOS — Hacker Web OS, Сделано в Санкт-Петербурге!"
    echo "Package manager 'hwins' installed."
    echo "Usage: hwins help"
    echo ""
    echo "Register hwins alias: echo 'alias pacman=hwins' >> /etc/bash.bashrc"
}

post_upgrade() {
    echo "hwins updated to version ${2} -> ${1}"
}

pre_remove() {
    echo "Removing hwins..."
}
