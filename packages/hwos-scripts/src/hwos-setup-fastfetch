#!/usr/bin/env bash
# hwos-setup-fastfetch - Configure fastfetch for HWOS branding
set -euo pipefail

HWOS_CONFIG_DIR="/etc/fastfetch"
HWOS_CONFIG_FILE="$HWOS_CONFIG_DIR/config.jsonc"

setup_fastfetch() {
    mkdir -p "$HWOS_CONFIG_DIR"

    cat > "$HWOS_CONFIG_FILE" << 'FASTFETCH'
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "color": {
      "1": "cyan",
      "2": "green"
    },
    "padding": {
      "left": 2,
      "right": 1
    }
  },
  "display": {
    "separator": " → ",
    "color": "cyan"
  },
  "modules": [
    {
      "type": "custom",
      "format": "┌─────────────────────────────────────────────┐"
    },
    {
      "type": "title",
      "format": "│  {#cyan}{1}{#green}@{#cyan}{2}{#reset}",
      "padding": "left"
    },
    {
      "type": "custom",
      "format": "├─────────────────────────────────────────────┤"
    },
    {
      "type": "os",
      "key": "│  OS",
      "keyColor": "green",
      "format": "{#cyan}{1}{#reset}"
    },
    {
      "type": "kernel",
      "key": "│  Kernel",
      "keyColor": "green",
      "format": "{#cyan}{1}{#reset}"
    },
    {
      "type": "uptime",
      "key": "│  Uptime",
      "keyColor": "green",
      "format": "{#cyan}{1}{#reset}"
    },
    {
      "type": "packages",
      "key": "│  Packages",
      "keyColor": "green",
      "format": "{#cyan}{1}{#reset}"
    },
    {
      "type": "shell",
      "key": "│  Shell",
      "keyColor": "green",
      "format": "{#cyan}{1}{#reset}"
    },
    {
      "type": "display",
      "key": "│  Display",
      "keyColor": "green",
      "format": "{#cyan}{1}{#reset}"
    },
    {
      "type": "wm",
      "key": "│  WM",
      "keyColor": "green",
      "format": "{#cyan}{1}{#reset}"
    },
    {
      "type": "terminal",
      "key": "│  Terminal",
      "keyColor": "green",
      "format": "{#cyan}{1}{#reset}"
    },
    {
      "type": "cpu",
      "key": "│  CPU",
      "keyColor": "green",
      "format": "{#cyan}{1}{#reset}"
    },
    {
      "type": "gpu",
      "key": "│  GPU",
      "keyColor": "green",
      "format": "{#cyan}{1}{#reset}"
    },
    {
      "type": "memory",
      "key": "│  Memory",
      "keyColor": "green",
      "format": "{#cyan}{1}{#reset}"
    },
    {
      "type": "disk",
      "key": "│  Disk",
      "keyColor": "green",
      "format": "{#cyan}{1}{#reset}"
    },
    {
      "type": "battery",
      "key": "│  Battery",
      "keyColor": "green",
      "format": "{#cyan}{1}{#reset}"
    },
    {
      "type": "localip",
      "key": "│  IP",
      "keyColor": "green",
      "format": "{#cyan}{1}{#reset}"
    },
    {
      "type": "custom",
      "format": "├─────────────────────────────────────────────┤"
    },
    {
      "type": "custom",
      "format": "│  {#green}HWOS{#cyan} - {#green}Hacker Web OS{#reset}"
    },
    {
      "type": "custom",
      "format": "└─────────────────────────────────────────────┘"
    }
  ]
}
FASTFETCH

    mkdir -p /etc/skel/.config/fastfetch
    cp "$HWOS_CONFIG_FILE" /etc/skel/.config/fastfetch/config.jsonc

    echo -e "${GREEN}[+] HWOS fastfetch configured${NC}"
}

setup_shell_aliases() {
    cat >> /etc/skel/.bashrc << 'BASHRC'

# HWOS Aliases
alias hwfetch="fastfetch -c /etc/fastfetch/config.jsonc"
alias hwupdate="hwos-update all"
alias hwfw="hwos-firewall"
alias hwencrypt="hwos-encrypt"
alias hwinstall="sudo hwos-installer"
alias hwhelp="hwos-help"
BASHRC

    cat > /etc/skel/.zshrc << 'ZSHRC'
# HWOS ZSH Configuration
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="hacker"
plugins=(git sudo archlinux systemd docker)

source $ZSH/oh-my-zsh.sh

# HWOS Aliases
alias hwfetch="fastfetch -c /etc/fastfetch/config.jsonc"
alias hwupdate="hwos-update all"
alias hwfw="hwos-firewall"
alias hwencrypt="hwos-encrypt"
alias hwinstall="sudo hwos-installer"
alias hwhelp="hwos-help"

# HWOS Prompt
PROMPT='%{%F{cyan}%}╭─%{%F{green}%}%n%{%F{white}%}@%{%F{cyan}%}%m %{%F{green}%}%~%{%F{white}%}
%{%F{cyan}%}╰─%{%F{green}%}$ %{%f%}'
RPROMPT='%{%F{cyan}%}[HWOS]%{%f%}'
ZSHRC

    cp /etc/skel/.zshrc /etc/skel/.zprofile 2>/dev/null || true
    echo -e "${GREEN}[+] HWOS shell aliases configured${NC}"
}

main() {
    setup_fastfetch
    setup_shell_aliases
    echo -e "${GREEN}[+] HWOS shell environment ready!${NC}"
}

main "$@"
