#!/usr/bin/env bash
# hwos-update — Обновление HWOS
set -euo pipefail

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; CYAN='\033[0;36m'; NC='\033[0m'

check_root() { [[ $EUID -eq 0 ]] || exec sudo "$0" "$@"; }

update_system() {
  echo -e "${CYAN}[*] Проверка обновлений...${NC}"
  pacman -Sy
  echo -e "${CYAN}[*] Обновление пакетов...${NC}"
  pacman -Su --noconfirm

  local orphans
  orphans=$(pacman -Qdtq 2>/dev/null || true)
  [[ -n "$orphans" ]] && echo -e "${YELLOW}[!] Есть пакеты-сироты:${NC}\n$orphans"
  echo -e "${GREEN}[+] Система обновлена!${NC}"
}

update_kernel() {
  echo -e "${CYAN}[*] Обновление ядра и initramfs...${NC}"
  pacman -S --noconfirm linux linux-headers
  mkinitcpio -P
  echo -e "${GREEN}[+] Ядро обновлено! Перезагрузитесь для применения.${NC}"
}

case "${1:-all}" in
  all|full) check_root; echo -e "${CYAN}═══════════════════════════════${NC}"
    echo -e "${CYAN}  ПОЛНОЕ ОБНОВЛЕНИЕ HWOS${NC}"
    echo -e "${CYAN}═══════════════════════════════${NC}"
    update_system; update_kernel ;;
  system) check_root; update_system ;;
  kernel) check_root; update_kernel ;;
  check) pacman -Sy; pacman -Qu ;;
  help)
    echo "Использование: hwos-update {all|system|kernel|check}"
    echo "  all    — Полное обновление"
    echo "  system — Только пакеты"
    echo "  kernel — Только ядро"
    echo "  check  — Проверить наличие обновлений" ;;
  *) echo "Использование: hwos-update {all|system|kernel|check}"; exit 1 ;;
esac
