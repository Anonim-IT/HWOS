#!/usr/bin/env bash
# hwos-update - HWOS System Updater
set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

check_root() {
    if [[ $EUID -ne 0 ]]; then
        echo -e "${RED}[!] This operation requires root privileges${NC}"
        exec sudo "$0" "$@"
    fi
}

pre_update_checks() {
    echo -e "${CYAN}[*] Pre-update checks...${NC}"

    AVAILABLE=$(df / | awk 'NR==2 {print $4}')
    if [[ $AVAILABLE -lt 5000000 ]]; then
        echo -e "${RED}[!] Low disk space: ${AVAILABLE}K free${NC}"
        echo -e "${YELLOW}[!] Cleaning package cache...${NC}"
        pacman -Sc --noconfirm 2>/dev/null || true
    fi

    if ! ping -c 1 -W 2 archlinux.org &>/dev/null; then
        echo -e "${RED}[!] No internet connection${NC}"
        exit 1
    fi

    echo -e "${GREEN}[+] Pre-checks passed${NC}"
}

update_system() {
    echo -e "${CYAN}[*] Starting HWOS update...${NC}"

    echo -e "${YELLOW}[*] Syncing repositories...${NC}"
    pacman -Sy --noconfirm

    echo -e "${YELLOW}[*] Upgrading all packages...${NC}"
    pacman -Su --noconfirm

    ORPHANS=$(pacman -Qdtq 2>/dev/null || true)
    if [[ -n "$ORPHANS" ]]; then
        echo -e "${YELLOW}[*] Orphaned packages found:${NC}"
        echo "$ORPHANS"
        echo -e "${YELLOW}[*] Remove with: pacman -Rns \$ORPHANS${NC}"
    fi

    echo -e "${GREEN}[+] System update complete!${NC}"
}

update_kernel() {
    echo -e "${CYAN}[*] Updating kernel and initramfs...${NC}"
    pacman -S --noconfirm linux-6.1 linux-6.1-headers
    mkinitcpio -P
    echo -e "${GREEN}[+] Kernel updated! Reboot to apply.${NC}"
}

case "${1:-all}" in
    all|full)
        check_root "$@"
        pre_update_checks
        update_system
        update_kernel
        ;;
    system)
        check_root "$@"
        pre_update_checks
        update_system
        ;;
    kernel)
        check_root "$@"
        update_kernel
        ;;
    check)
        pre_update_checks
        pacman -Sy
        pacman -Qu
        ;;
    help|--help)
        echo "Usage: hwos-update {all|system|kernel|check}"
        ;;
    *)
        echo "Usage: hwos-update {all|system|kernel|check}"
        exit 1
        ;;
esac
