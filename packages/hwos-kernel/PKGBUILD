# Maintainer: HWOS Team <dev@hwos.dev>
# Custom HWOS kernel based on Linux 6.1 LTS with hardening patches

_kernelname=-hwos
_kernelver=6.1.100
_kernelver_major=6.1
pkgbase=linux-6.1-hwos
pkgver=${_kernelver}.arch1
pkgrel=1
pkgdesc="HWOS custom kernel - Linux 6.1 LTS hardened for Hacker Web OS"
arch=('x86_64')
url="https://hwos.dev"
license=('GPL2')
makedepends=(
  'bc' 'cpio' 'gettext' 'libelf' 'pahole' 'perl'
  'python' 'rsync' 'tar' 'tevent' 'xmlto'
  'kmod' 'inetutils' 'base-devel'
)
options=('!strip')
source=(
  "https://cdn.kernel.org/pub/linux/kernel/v${_kernelver_major}.x/linux-${_kernelver}.tar.xz"
  "https://raw.githubusercontent.com/archlinux/svntogit-packages/packages/linux/trunk/config"
  "hwos-hardening.patch"
  "config"
)
validpgpkeys=(
  'ABAF11C65A2970B130ABE3C479BE3E4300411886'  # Linus Torvalds
  '647F28654894E3BD457199BE38DBBDC86092693E'  # Greg Kroah-Hartman
)
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP')

prepare() {
  cd "linux-${_kernelver}"
  patch -p1 -i "${srcdir}/hwos-hardening.patch" 2>/dev/null || true
  cp ../config .config
  make olddefconfig
}

build() {
  cd "linux-${_kernelver}"
  make -j$(nproc) all
  make -j$(nproc) htmldocs 2>/dev/null || true
}

package() {
  cd "linux-${_kernelver}"

  make INSTALL_MOD_PATH="${pkgdir}/usr" INSTALL_MOD_STRIP=1 modules_install
  make INSTALL_PATH="${pkgdir}/usr" \
    INSTALL_DTBS_PATH="${pkgdir}/usr/lib/dtbs/${pkgbase}" dtbs_install 2>/dev/null || true
  make INSTALL_PATH="${pkgdir}/usr" install

  mkdir -p "${pkgdir}/usr/share/doc/${pkgbase}"
  cp Documentation/output/* "${pkgdir}/usr/share/doc/${pkgbase}/" 2>/dev/null || true
}

_kernelheaders() {
  pkgdesc="HWOS kernel headers for Linux 6.1 LTS"
  depends=('awk' 'libelf' 'tar' 'perl' 'python')
  pkgname=linux-6.1-hwos-headers
}

_kerneldocs() {
  pkgdesc="HWOS kernel documentation for Linux 6.1 LTS"
  pkgname=linux-6.1-hwos-docs
}
