# Maintainer: HWOS Team <dev@hwos.dev>
pkgname=hwos-installer
pkgver=1.0.0
pkgrel=2
pkgdesc="HWOS TUI installer (Python curses) for Hacker Web OS — Сделано в Санкт-Петербурге"
arch=('any')
url="https://hwos.dev"
license=('GPL3')
depends=('python' 'parted' 'btrfs-progs' 'cryptsetup' 'arch-install-scripts' 'dosfstools')
install=hwos-installer.install
source=("src/hwos-installer")
sha256sums=('SKIP')

package() {
    install -Dm755 src/hwos-installer "${pkgdir}/usr/local/bin/hwos-installer"
    ln -sf /usr/local/bin/hwos-installer "${pkgdir}/usr/bin/hwos-installer"
}
