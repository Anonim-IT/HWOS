        f"Регион: {region}\nРежим: {mode}\nДиск: {disk}\nПользователь: {uname}\nПК: {hn}\n\nНачать установку?",
        f"Region: {region}\nMode: {mode}\nDisk: {disk}\nUser: {uname}\nHost: {hn}\n\nStart installation?")
    if not yesno(stdscr, _("Подтверждение", "Confirm"), summary):
        return

    do_install(stdscr, disk, mode, region, uname, pw, hn)

    msgbox(stdscr, _("Готово!", "Done!"), _(
        "HWOS установлена!\nРегион: {region}\nПользователь: {uname}\n\nСделано в Санкт-Петербурге ❤️",
        "HWOS is installed!\nRegion: {region}\nUser: {uname}\n\nMade in Saint Petersburg ❤️"))

    if yesno(stdscr, _("Перезагрузка", "Reboot"), _("Перезагрузить сейчас?", "Reboot now?")):
        os.system("reboot")

if __name__ == "__main__":
    check_root()
    curses.wrapper(main)
