def select_region(stdscr) -> str:
    items = [
        (_("🇷🇺 Россия — русский, Яндекс-зеркала"), "ru"),
        (_("🌍 Международный — английский, глобальные"), "int"),
    ]
    idx = menu(stdscr, _("Выбор региона", "Region"), _("Где будет использоваться HWOS?", "Where will HWOS be used?"), [i[0] for i in items])
    if idx is None:
        return "ru"
    return items[idx][1]

def select_lang(stdscr):
    items = [_("Русский"), "English"]
    idx = menu(stdscr, _("Язык установщика", "Installer Language"), "", items)
    if idx is not None:
        global LANG, IS_RU
        LANG = "ru_RU.UTF-8" if idx == 0 else "en_US.UTF-8"
        IS_RU = idx == 0
        os.environ["LANG"] = LANG

def select_mode(stdscr) -> str:
    items = [
        (_("Для новичков — авторазметка, всё само"), "easy"),
        (_("Эксперт — ручные разделы через cfdisk"), "expert"),
    ]
    idx = menu(stdscr, _("Режим установки", "Mode"), "", [i[0] for i in items])
    return items[idx][1] if idx is not None else "easy"

def select_disk_menu(stdscr) -> str:
    disks = get_disks()
    if not disks:
        msgbox(stdscr, _("Ошибка", "Error"), _("Не найден ни один диск!", "No disks found!"))
        return ""
    items = [f"{d[0]}  [{d[1]}]" for d in disks]
    idx = menu(stdscr, _("Выбор диска", "Select Disk"), _("Выберите целевой диск:", "Select target disk:"), items)
    return disks[idx][0] if idx is not None else ""

def get_user_info(stdscr):
    uname = inputbox(stdscr, _("Пользователь", "User"), _("Введите имя пользователя:", "Enter username:"), "user")
    if not uname:
        return None, None, None
    pw = passwordbox(stdscr, _("Пароль", "Password"), _("Введите пароль:", "Enter password:"))
    if not pw:
        return None, None, None
    hn = inputbox(stdscr, _("Имя ПК", "Hostname"), _("Имя компьютера (hostname):", "Computer hostname:"), "hwos")
    if not hn:
        hn = "hwos"
    return uname, pw, hn

def do_install(stdscr, disk: str, mode: str, region: str, username: str, password: str, hostname: str):
    # Partition
    w = None
    if mode == "easy":
        win, w = progress(stdscr, _("Авторазметка", "Partitioning"), _("Размечаем диск...", "Partitioning disk..."))
        parted_ok, err = run_step(win, w, ["parted", "-s", disk, "mklabel", "gpt"], "mklabel")
        run_step(win, w, ["parted", "-s", disk, "mkpart", "primary", "fat32", "1MiB", "512MiB"], "ESP")
        run_step(win, w, ["parted", "-s", disk, "set", "1", "esp", "on"], "ESP flag")
        swap_mb = int(run_capture(["free", "-m"]).split("\n")[1].split()[1]) // 2
        swap_end = swap_mb + 4096
        run_step(win, w, ["parted", "-s", disk, "mkpart", "primary", "linux-swap", "512MiB", f"{swap_end}MiB"], "SWAP")
        run_step(win, w, ["parted", "-s", disk, "mkpart", "primary", f"{swap_end}MiB", "100%"], "ROOT")
        time.sleep(1)
    else:
        msgbox(stdscr, _("Ручная разметка", "Manual"), _("Сейчас откроется cfdisk.\nСоздайте: ESP(fat32,512M), SWAP(linux-swap,2-4G), ROOT(ext4).\nЗакройте cfdisk когда закончите.", "cfdisk will open.\nCreate: ESP(fat32,512M), SWAP, ROOT.\nClose when done."))
        run(["cfdisk", disk], check=False)

    # Detect partitions
    esp, swap, root = detect_partitions(disk)

    # Confirm format
    if not yesno(stdscr, _("Форматирование", "Format"), _(
        f"Будут отформатированы:\n  ESP: {esp}\n  ROOT: {root}\n\nВсе данные будут УНИЧТОЖЕНЫ!",
        f"Will format:\n  ESP: {esp}\n  ROOT: {root}\n\nALL data will be DESTROYED!")):
        return

    # Format
    win, w = progress(stdscr, _("Форматирование", "Formatting"), _("Форматируем разделы...", "Formatting partitions..."))
    run_step(win, w, ["mkfs.fat", "-F32", esp], "mkfs.fat ESP")
    run_step(win, w, ["mkfs.ext4", "-F", root], "mkfs.ext4 ROOT")
    if swap:
        run_step(win, w, ["mkswap", swap], "mkswap SWAP")

    # Mount
    win.addstr(2, 2, _("Монтируем разделы...", "Mounting partitions..."), c(C_YELLOW))
    win.refresh()
    run(["mount", root, "/mnt"])
    os.makedirs("/mnt/boot", exist_ok=True)
    run(["mount", esp, "/mnt/boot"])
    if swap:
        run(["swapon", swap], check=False)

    # Pacstrap
    pkgs = [
        "base", "base-devel",
        "linux-hacker", "linux-hacker-headers", "linux-firmware",
        "grub", "efibootmgr",
        "networkmanager", "dhcpcd", "nano", "vim", "sudo", "dialog",
        "hwins", "hackerrub", "hwos-scripts", "hwos-configs", "hwos-theme",
    ]
    if region == "ru":
        pkgs += ["ttf-liberation", "ttf-dejavu", "noto-fonts", "noto-fonts-emoji"]

    # Mirrorlist
    if region == "ru":
        ml = "Server = https://mirror.yandex.ru/archlinux/$repo/os/$arch\nServer = https://archlinux.mirror.colo-serv.net/$repo/os/$arch"
    else:
        ml = "Server = https://archlinux.mirror.colo-serv.net/$repo/os/$arch\nServer = https://mirror.rackspace.com/archlinux/$repo/os/$arch"

    win.addstr(2, 2, _("Устанавливаем пакеты (pacstrap)...", "Installing packages (pacstrap)..."), c(C_YELLOW))
    win.refresh()
    os.makedirs("/mnt/etc/pacman.d", exist_ok=True)
    with open("/mnt/etc/pacman.d/mirrorlist", "w") as f:
        f.write("## HWOS\n" + ml + "\n")
    update_progress(win, w, 10)

    r = subprocess.run(["pacstrap", "-K", "/mnt"] + pkgs, capture_output=True, text=True)
    if r.returncode != 0:
        msgbox(stdscr, _("Ошибка", "Error"), _("Pacstrap не удался:\n", "Pacstrap failed:\n") + (r.stderr[-300:] if r.stderr else ""))
        return
    update_progress(win, w, 60)

    # Configure
    win.addstr(2, 2, _("Настраиваем систему...", "Configuring system..."), c(C_YELLOW))
    win.refresh()

    # fstab
    run(["genfstab", "-U", "/mnt"], stdout=open("/mnt/etc/fstab", "a"))
    update_progress(win, w, 65)

    # locale
    with open("/mnt/etc/locale.gen", "w") as f:
        f.write("ru_RU.UTF-8 UTF-8\nen_US.UTF-8 UTF-8\n")
    if region == "ru":
        with open("/mnt/etc/locale.conf", "w") as f:
            f.write("LANG=ru_RU.UTF-8\n")
        with open("/mnt/etc/vconsole.conf", "w") as f:
            f.write("KEYMAP=ru\nFONT=cyr-sun16\n")
        chroot(["ln", "-sf", "/usr/share/zoneinfo/Europe/Moscow", "/etc/localtime"])
    else:
        with open("/mnt/etc/locale.conf", "w") as f:
            f.write("LANG=en_US.UTF-8\n")
        with open("/mnt/etc/vconsole.conf", "w") as f:
            f.write("KEYMAP=us\n")
        chroot(["ln", "-sf", "/usr/share/zoneinfo/UTC", "/etc/localtime"])
    chroot(["locale-gen"])
    update_progress(win, w, 70)

    # hostname
    with open("/mnt/etc/hostname", "w") as f:
        f.write(hostname + "\n")
    with open("/mnt/etc/hosts", "w") as f:
        f.write(f"127.0.0.1   localhost\n::1         localhost\n127.0.1.1   {hostname}\n")
    update_progress(win, w, 75)

    # user
    chroot(["useradd", "-m", "-G", "wheel,audio,video,storage", "-s", "/bin/bash", username])
    r = chroot(["chpasswd"])
    with open("/tmp/pw", "w") as f:
        f.write(f"{username}:{password}\n")
    run(["arch-chroot", "/mnt", "chpasswd"], stdin=open("/tmp/pw"))
    run(["arch-chroot", "/mnt", "sh", "-c", "echo 'root:root' | chpasswd"])
    os.makedirs("/mnt/etc/sudoers.d", exist_ok=True)
    with open("/mnt/etc/sudoers.d/wheel", "w") as f:
        f.write("%wheel ALL=(ALL:ALL) ALL\n")
    update_progress(win, w, 80)

    # GRUB (HackerRUB)
    run(["arch-chroot", "/mnt", "grub-install",
         "--target=x86_64-efi", "--efi-directory=/boot",
         "--bootloader-id=HackerRUB", "--recheck"], check=False)
    update_progress(win, w, 85)

    grub_cfg = """GRUB_DEFAULT=0
GRUB_TIMEOUT=5
GRUB_DISTRIBUTOR="HWOS — Сделано в Санкт-Петербурге"
GRUB_CMDLINE_LINUX_DEFAULT="loglevel=3 quiet nowatchdog"
GRUB_TERMINAL_OUTPUT="gfxterm"
GRUB_GFXMODE="1920x1080,1280x720,auto"
GRUB_THEME="/boot/grub/themes/hackerrub/theme.txt"
GRUB_DISABLE_OS_PROBER=false
GRUB_DISABLE_RECOVERY=true
GRUB_SAVEDEFAULT=true
"""
    with open("/mnt/etc/default/grub", "w") as f:
        f.write(grub_cfg)
    run(["arch-chroot", "/mnt", "grub-mkconfig", "-o", "/boot/grub/grub.cfg"], check=False)
    update_progress(win, w, 90)

    # Services
    chroot(["systemctl", "enable", "NetworkManager"])
    chroot(["systemctl", "enable", "systemd-timesyncd"])
    update_progress(win, w, 100)

    time.sleep(0.5)

