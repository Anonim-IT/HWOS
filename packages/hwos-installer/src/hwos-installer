def _(ru: str, en: str = "") -> str:
    return ru if IS_RU else (en or ru)

# ─── Colors ────────────────────────────────────────────────────
C_WHITE = 1
C_BLUE = 2
C_RED = 3
C_CYAN = 4
C_GREEN = 5
C_YELLOW = 6
C_DIM = 7
C_TITLE = 8

def init_colors():
    curses.init_pair(C_WHITE, curses.COLOR_WHITE, -1)
    curses.init_pair(C_BLUE, curses.COLOR_BLUE, -1)
    curses.init_pair(C_RED, curses.COLOR_RED, -1)
    curses.init_pair(C_CYAN, curses.COLOR_CYAN, -1)
    curses.init_pair(C_GREEN, curses.COLOR_GREEN, -1)
    curses.init_pair(C_YELLOW, curses.COLOR_YELLOW, -1)
    curses.init_pair(C_DIM, curses.COLOR_WHITE, -1)
    curses.init_pair(C_TITLE, curses.COLOR_CYAN, -1)

def c(pair: int, bold: bool = False):
    attr = curses.color_pair(pair)
    if bold:
        attr |= curses.A_BOLD
    return attr

# ─── UI helpers ────────────────────────────────────────────────
def center_y(h: int) -> int:
    return max(0, (curses.LINES - h) // 2)

def center_x(w: int) -> int:
    return max(0, (curses.COLS - w) // 2)

def draw_border(win, title: str = "", color_pair: int = C_CYAN):
    h, w = win.getmaxyx()
    win.attron(c(color_pair))
    win.border()
    if title:
        win.addstr(0, center_x(len(title) + 2), f" {title} ", c(color_pair, True))
    win.attroff(c(color_pair))

def draw_header(stdscr):
    hdr = f" HWOS Installer v{VERSION} — Сделано в Санкт-Петербурге "
    stdscr.attron(c(C_WHITE, True) | curses.A_REVERSE)
    stdscr.addstr(0, 0, hdr.center(curses.COLS))
    stdscr.attroff(c(C_WHITE, True) | curses.A_REVERSE)

def msgbox(stdscr, title: str, text: str, width: int = 60, height: int = 8):
    h = height
    w = min(width, curses.COLS - 4)
    y = center_y(h)
    x = center_x(w)
    win = curses.newwin(h, w, y, x)
    win.clear()
    draw_border(win, title, C_CYAN)
    lines = text.split("\n")
    for i, line in enumerate(lines):
        if i + 1 < h - 1:
            win.addstr(i + 1, 2, line[: w - 4], c(C_WHITE))
    win.addstr(h - 2, center_x(12), _("[ Enter ]", "[ OK ]"), c(C_GREEN, True))
    win.refresh()
    stdscr.getch()

def yesno(stdscr, title: str, text: str, width: int = 60, height: int = 8) -> bool:
    h = height
    w = min(width, curses.COLS - 4)
    y = center_y(h)
    x = center_x(w)
    win = curses.newwin(h, w, y, x)
    win.clear()
    draw_border(win, title, C_CYAN)
    lines = text.split("\n")
    for i, line in enumerate(lines):
        if i + 1 < h - 3:
            win.addstr(i + 1, 2, line[: w - 4], c(C_WHITE))
    sel = 1
    while True:
        for i, lbl in enumerate([_("[ Нет ]", " [ No ] "), _("[ Да ]", " [ Yes ] ")]):
            attr = c(C_GREEN, True) | curses.A_REVERSE if i == sel else c(C_GREEN, True)
            win.addstr(h - 2, center_x(18) + i * 12, lbl, attr)
        win.refresh()
        k = stdscr.getch()
        if k == curses.KEY_LEFT and sel > 0:
            sel -= 1
        elif k == curses.KEY_RIGHT and sel < 1:
            sel += 1
        elif k in (10, 13, ord(" ")):
            return sel == 1
        elif k == 27:
            return False

def inputbox(stdscr, title: str, prompt: str, default: str = "", width: int = 50) -> Optional[str]:
    h, w = 8, min(width + 4, curses.COLS - 2)
    y = center_y(h)
    x = center_x(w)
    win = curses.newwin(h, w, y, x)
    win.clear()
    draw_border(win, title, C_CYAN)
    win.addstr(1, 2, prompt[: w - 4], c(C_WHITE, True))
    edit_h, edit_w = 1, w - 6
    edit_win = curses.newwin(edit_h, edit_w, y + 3, x + 2)
    tb = curses.textpad.Textbox(edit_win)
    tb.stripspaces = 1
    edit_win.addstr(0, 0, default[: edit_w - 1], c(C_WHITE))
    curses.curs_set(1)
    result = tb.edit()
    curses.curs_set(0)
    return result.strip() if result else None

def passwordbox(stdscr, title: str, prompt: str, width: int = 50) -> Optional[str]:
    h, w = 8, min(width + 4, curses.COLS - 2)
    y = center_y(h)
    x = center_x(w)
    win = curses.newwin(h, w, y, x)
    win.clear()
    draw_border(win, title, C_CYAN)
    win.addstr(1, 2, prompt[: w - 4], c(C_WHITE, True))
    curses.curs_set(1)
    buf = ""
    while True:
        ch = stdscr.getch()
        if ch in (10, 13):
            break
        elif ch in (127, curses.KEY_BACKSPACE, 8):
            if buf:
                buf = buf[:-1]
                cy, cx = win.getyx()
                win.addstr(y + 3, x + 2 + len(buf), " ")
        elif ch == 27:
            curses.curs_set(0)
            return None
        elif 32 <= ch <= 126:
            buf += chr(ch)
        win.addstr(3, 2, "*" * len(buf), c(C_WHITE))
        win.refresh()
    curses.curs_set(0)
    return buf

def menu(stdscr, title: str, prompt: str, items: list, width: int = 60) -> Optional[int]:
    n = len(items)
    list_h = n + 2
    h = min(list_h + 4, curses.LINES - 4)
    w = min(width, curses.COLS - 4)
    y = center_y(h)
    x = center_x(w)
    sel = 0
    offset = 0
    max_visible = max(1, h - 5)
    while True:
        win = curses.newwin(h, w, y, x)
        win.clear()
        draw_border(win, title, C_CYAN)
        if prompt:
            win.addstr(1, 2, prompt[: w - 4], c(C_DIM))
        if offset > 0:
            win.addstr(2, w - 2, "▲", c(C_DIM))
        visible = min(n - offset, max_visible)
        for i in range(visible):
            idx = offset + i
            lbl = items[idx] if isinstance(items[idx], str) else str(items[idx])
            lbl = lbl[: w - 6]
            if idx == sel:
                win.attron(c(C_GREEN, True) | curses.A_REVERSE)
                win.addstr(i + 2, 2, f" {lbl} ".ljust(w - 5))
                win.attroff(c(C_GREEN, True) | curses.A_REVERSE)
            else:
                win.addstr(i + 2, 2, f" {lbl} ".ljust(w - 5), c(C_WHITE))
        if offset + visible < n:
            win.addstr(h - 2, w - 2, "▼", c(C_DIM))
        win.refresh()
        k = stdscr.getch()
        if k == curses.KEY_UP and sel > 0:
            sel -= 1
            if sel < offset:
                offset = sel
        elif k == curses.KEY_DOWN and sel < n - 1:
            sel += 1
            if sel >= offset + max_visible:
                offset = min(sel, n - max_visible)
        elif k in (10, 13, ord(" ")):
            return sel
        elif k == 27:
            return None

def progress(stdscr, title: str, text: str, total: int = 100):
    h, w = 6, 60
    y = center_y(h)
    x = center_x(w)
    win = curses.newwin(h, w, y, x)
    win.clear()
    draw_border(win, title, C_CYAN)
    win.addstr(1, 2, text[: w - 4], c(C_WHITE))
    win.refresh()
    return win, w

def update_progress(win, w, pct: int):
    bar_w = w - 6
    filled = int(bar_w * pct / 100)
    bar = "█" * filled + "░" * (bar_w - filled)
    win.addstr(3, 2, bar[: w - 4], c(C_CYAN, True))
    win.addstr(3, 2 + bar_w + 1, f"{pct}%", c(C_GREEN, True))
    win.refresh()

# ─── System helpers ────────────────────────────────────────────
def run(cmd: list, check: bool = True, **kwargs):
    return subprocess.run(cmd, check=check, **kwargs)

def run_capture(cmd: list) -> str:
    r = subprocess.run(cmd, capture_output=True, text=True)
    return r.stdout.strip()

def check_root():
    if os.geteuid() != 0:
        print(_("Требуются права root. Запустите с sudo.", "Root required. Run with sudo."))
        sys.exit(1)

def get_disks() -> list:
    out = run_capture(["lsblk", "-dno", "NAME,SIZE,MODEL"])
    disks = []
    for line in out.split("\n"):
        parts = line.split(None, 2)
        if parts:
            name = parts[0]
            size = parts[1] if len(parts) > 1 else ""
            model = parts[2] if len(parts) > 2 else ""
            disks.append((f"/dev/{name}", f"{size}  {model}"))
    return disks

def detect_partitions(disk: str):
    out = run_capture(["lsblk", "-nlo", "NAME,TYPE,FSTYPE", disk])
    esp, swap, root = "", "", ""
    for line in out.split("\n"):
        parts = line.split()
        if len(parts) < 3:
            continue
        name, typ, fstype = parts[0], parts[1], parts[2]
        dev = f"/dev/{name}"
        if typ != "part":
            continue
        if fstype in ("vfat", "fat32") or "esp" in name.lower():
            esp = dev
        elif fstype == "swap":
            swap = dev
        elif not root:
            root = dev
    if not esp:
        esp = f"/dev/{run_capture(['lsblk', '-nlo', 'NAME', disk]).split()[0]}"
    if not root:
        parts = [l.split()[0] for l in out.split("\n") if "part" in l]
        if parts:
            root = f"/dev/{parts[-1]}"
    return esp, swap, root

def step(stdscr, title: str, text: str, pct: int):
    h, w = 6, 60
    y = center_y(h)
    x = center_x(w)
    win = curses.newwin(h, w, y, x)
    win.clear()
    draw_border(win, title, C_CYAN)
    win.addstr(1, 2, text[: w - 4], c(C_WHITE))
    update_progress(win, w, pct)
    win.refresh()
    return win

def run_step(win, w, cmd: list, label: str):
    win.addstr(2, 2, label[: w - 4], c(C_YELLOW))
    win.refresh()
    r = subprocess.run(cmd, capture_output=True, text=True)
    if r.returncode != 0:
        return False, r.stderr
    return True, ""

def chroot(cmd: list):
    return run(["arch-chroot", "/mnt"] + cmd, check=False, capture_output=True, text=True)

